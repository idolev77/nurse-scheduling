# ── Python cache ──────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
*.so

# ── Virtual environments ───────────────────────────────
.venv/
venv/
env/
ENV/

# ── Secrets / environment files ───────────────────────
# The .env is mounted at runtime via docker-compose env_file.
# Never bake secrets into the image layer.
.env
*.env

# ── Database files (SQLite dev artifacts) ─────────────
*.db
*.sqlite
*.sqlite3

# ── IDE / editor ──────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ── Tests ─────────────────────────────────────────────
tests/
test_*.py
*_test.py
.pytest_cache/
htmlcov/
.coverage

# ── Git ───────────────────────────────────────────────
.git/
.gitignore
